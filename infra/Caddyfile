# O domínio vem do .env (APP_DOMAIN). Sem domínio próprio, use o truque
# sslip.io: APP_DOMAIN=169-58-242-252.sslip.io resolve para o IP da VPS e
# o Caddy emite TLS (Let's Encrypt) normalmente. Troque pelo domínio real
# quando tiver — só mudar o .env e `docker compose restart caddy`.

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Evolution API e Uptime Kuma NUNCA são expostos publicamente — acesso
# interno pela rede do compose; Kuma via túnel SSH (porta 3001 local).
