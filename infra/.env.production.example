# ═════════ ClinicaOS — PRODUÇÃO (copiar para infra/.env na VPS) ═════════
# Gere segredos com:  openssl rand -base64 32

# ── Domínio e URL pública ─────────────────────────────────────────────
# Sem domínio próprio ainda? Use sslip.io (resolve para o IP, TLS funciona):
APP_DOMAIN=169-58-242-252.sslip.io
APP_URL=https://169-58-242-252.sslip.io

# ── Postgres (senhas FORTES e diferentes entre si) ────────────────────
POSTGRES_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
DB_WORKER_PASSWORD=

# As URLs de banco (DATABASE_URL, _WORKER, _MIGRATOR) são montadas pelo
# docker-compose a partir das senhas acima — não precisa escrever aqui.

REDIS_URL=redis://redis:6379

# ── Cifra de dados sensíveis (anamnese, chaves de IA das clínicas) ────
# NUNCA trocar depois de ter dados (perderia acesso ao que foi cifrado)
SENSITIVE_DATA_KEY=

# ── WhatsApp (Evolution API interna) ──────────────────────────────────
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
# Se o QR parar de nascer (statusReason 405 nos logs do evolution), pegue a
# versão corrente em https://raw.githubusercontent.com/wppconnect-team/wa-version/main/versions.json
# (campo currentVersion, sem o -alpha) e descomente:
# CONFIG_SESSION_PHONE_VERSION=2.3000.1046291534

# ── PDF dos termos ────────────────────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000
STORAGE_DIR=/data/storage

# ── IA (provedor padrão do sistema; clínicas podem usar chave própria) ─
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ou: AI_PROVIDER=openai + OPENAI_API_KEY=... (+ AI_BASE_URL p/ Groq/Ollama)
OPENAI_API_KEY=
AI_BASE_URL=
AI_AGENT_MODEL=
AI_CLASSIFIER_MODEL=
AI_MONTHLY_TOKEN_CAP=

# ── Primeira conta (usada pelo seed de implantação — troque os valores!) ─
SEED_CLINIC_NAME=
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ── Backup off-site opcional (Backblaze B2 via restic) ────────────────
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=

# ── E-mail transacional (Resend) ──────────────────────────────────────
RESEND_API_KEY=
