# ── Banco de dados ────────────────────────────────────────────────
# Dev local: o compose mapeia o Postgres para 5434 no host (5432/5433 em uso por outros projetos)
# Usuário da aplicação (SEM bypass de RLS — ver packages/db/migrations)
DATABASE_URL=postgres://clinicaos_app:app_dev_password@localhost:5434/clinicaos
# Usuário de migração (owner do schema, roda migrations)
DATABASE_URL_MIGRATOR=postgres://clinicaos_migrator:migrator_dev_password@localhost:5434/clinicaos
# Usuário do worker (BYPASSRLS — varreduras cross-tenant dos schedulers)
DATABASE_URL_WORKER=postgres://clinicaos_worker:worker_dev_password@localhost:5434/clinicaos

# ── Redis (BullMQ) ────────────────────────────────────────────────
# Dev local: o compose mapeia para 6380 no host (6379 costuma estar em uso)
REDIS_URL=redis://localhost:6380

# ── App ───────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Chave de 32 bytes em base64 para cifra AES-256-GCM de dados sensíveis (anamnese/evolução).
# Gere com: openssl rand -base64 32  (NUNCA commitar a real)
SENSITIVE_DATA_KEY=
# Ambiente: development | staging | production
NODE_ENV=development
# Habilita endpoint de relógio simulado (/api/dev/clock). NUNCA "true" em produção.
ENABLE_DEV_CLOCK=true

# ── Evolution API ─────────────────────────────────────────────────
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-global-key

# ── Gotenberg (PDF dos termos) ────────────────────────────────────
GOTENBERG_URL=http://localhost:3005
# Diretório de arquivos (PDFs, fotos). Produção: /data/storage (volume)
STORAGE_DIR=./.data/storage

# ── Anthropic (IA) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── E-mail transacional (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=ClinicaOS <nao-responda@example.com>

# ── Sentry (observabilidade) ──────────────────────────────────────
SENTRY_DSN=
